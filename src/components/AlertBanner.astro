---
import { phoneHref, settings } from '../data/site';
---

{settings.alert_on && (
  <div class="alert on-dark" role="status">
    <span><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l10 18H2z"></path><path d="M12 10v5"></path><path d="M12 18h.01"></path></svg>{settings.alert_message}</span>
    <a href={phoneHref}>Call {settings.phone}</a>
  </div>
)}

<style>
  .alert {
    background: var(--red);
    color: #FFFFFF;
    padding: 12px 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 16px;
    font-weight: 600;
    text-align: center;
  }
  .alert svg { vertical-align: -5px; margin-right: 16px; }
  @media (max-width: 759px) {
    .alert svg { margin-right: 8px; }
  }
  .alert a, .alert a:hover {
    color: #FFFFFF;
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
