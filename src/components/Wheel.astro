---
// The wheel "period" after big titles. `order` delays the roll on pages with
// more than one wheel (2 and 3 start a little after 1).
import wheel from '../assets/wheel.svg';

interface Props {
  order?: 1 | 2 | 3;
}
const { order = 1 } = Astro.props;
---

<img class:list={['bk-wheel', `bk-wheel-${order}`]} src={wheel.src} width={wheel.width} height={wheel.height} alt="" />
