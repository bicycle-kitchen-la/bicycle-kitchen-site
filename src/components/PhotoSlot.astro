---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos, youtubeVideo } from '../data/site';

interface Props {
  // The photo's name in src/content/photos.yml
  name: string;
  // Text on the placeholder box, shown until a photo is uploaded
  placeholder: string;
  // Sets the slot's size and shape
  class: string;
  tone?: 'light' | 'mid' | 'dark';
  // How wide the photo appears on the page, so browsers download the right size
  sizes: string;
  eager?: boolean;
}

const { name, placeholder, class: className, tone = 'light', sizes, eager = false } = Astro.props;

// A slot with no photo may be saved as blank or left out entirely. Either way,
// it shows the placeholder.
const photo = photos[name];

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);

let image: ImageMetadata | undefined;
if (photo?.image) {
  const fileName = photo.image.split('/').pop();
  const match = Object.entries(files).find(([path]) => path.endsWith(`/${fileName}`));
  if (!match) {
    throw new Error(
      `Photo slot "${name}" points to "${photo.image}", but that file isn't in src/assets/photos/. It must be a JPG, PNG, WebP, or AVIF.`,
    );
  }
  image = match[1].default;
}

// A video link (only some slots offer one) takes the photo's place. Nothing
// loads from YouTube until someone presses play, so the page stays fast and
// YouTube can't track visitors who never watch.
const video = photo?.video ? youtubeVideo(photo.video) : undefined;
const poster = video && `https://i.ytimg.com/vi/${video.id}/${video.tall ? 'oardefault' : 'hqdefault'}.jpg`;
---

{video ? (
  <div class:list={['photo-slot', 'has-video', { 'is-tall': video.tall }, className]}>
    <a class="video-start" href={video.link} data-video-id={video.id} aria-label="Play video">
      <img src={poster} alt="" loading="lazy" referrerpolicy="no-referrer" />
      <svg class="video-play-icon" aria-hidden="true" width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="36" fill="#A63A22"></circle><path d="M29 23l22 13-22 13z" fill="#FFFFFF"></path></svg>
    </a>
  </div>
) : image ? (
  <div class:list={['photo-slot', 'has-photo', `tone-${tone}`, className]}>
    <Picture
      src={image}
      alt={photo?.alt ?? ''}
      formats={['avif', 'webp']}
      widths={[400, 800, 1200].filter((width) => width <= image.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
) : (
  <div class:list={['photo-slot', `tone-${tone}`, className]}>{placeholder}</div>
)}

<script>
  // Swap the still image for the YouTube player when someone presses play.
  for (const start of document.querySelectorAll<HTMLAnchorElement>('.video-start')) {
    start.addEventListener('click', (event) => {
      event.preventDefault();
      const player = document.createElement('iframe');
      player.src = `https://www.youtube-nocookie.com/embed/${start.dataset.videoId}?autoplay=1&playsinline=1&rel=0`;
      player.title = 'YouTube video';
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      start.replaceWith(player);
      player.focus();
    });
  }
</script>
