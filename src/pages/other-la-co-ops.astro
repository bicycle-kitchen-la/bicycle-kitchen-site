---
import { Image } from 'astro:assets';
import mapImage from '../assets/maps/la-co-ops.png';
import Wheel from '../components/Wheel.astro';
import { coOpsPage, telHref } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// The words all live in src/content/co-ops.yml. Links and page anchors are built
// from them here, so volunteers only type an address, a phone number, and so on.
const labels = coOpsPage.map_labels;
const coOps = coOpsPage.co_ops.map((coOp) => {
  const instagram = coOp.instagram?.trim().replace(/^@/, '');
  return {
    ...coOp,
    id: coOp.name.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    directions: `https://maps.google.com/?${new URLSearchParams({ q: coOp.address.replace(/,/g, '') })}`,
    contacts: [
      coOp.phone && { label: coOp.phone, href: telHref(coOp.phone) },
      coOp.email && { label: coOp.email, href: `mailto:${coOp.email}` },
      instagram && { label: `Instagram @${instagram}`, href: `https://www.instagram.com/${instagram}/` },
    ].filter((contact) => !!contact),
  };
});
---

<BaseLayout
  title="Other LA Co-Ops · Bicycle Kitchen"
  description={coOpsPage.search_description}
  breadcrumbs={[{ label: 'About' }]}
  breadcrumbCurrent="Other LA Co-Ops"
>
  <section class="page-hero coops-hero" aria-labelledby="coops-h">
    <div class="container">
      <h1 id="coops-h" class="page-title coops-title">Other LA <span class="no-break">Co-Ops<Wheel /></span></h1>
      <p class="coops-lead">{coOpsPage.lead}</p>
      <p class="coops-intro">{coOpsPage.intro}</p>

      <div class="map-row">
        <figure class="map-figure">
          <div class="map" role="img" aria-label={coOpsPage.map_description}>
            <Image src={mapImage} alt="" widths={[400, 700, 1000, 1400]} sizes="(min-width: 1280px) 760px, (min-width: 760px) 60vw, 100vw" />
            <span class="map-label label-bikerowave">{labels.bikerowave}</span>
            <span class="map-label label-kitchen">{labels.kitchen}</span>
            <span class="map-label label-oven">{labels.bike_oven}</span>
          </div>
          <figcaption>{coOpsPage.map_caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {coOps.map((coOp) => (
    <section id={coOp.id} class="section coop" aria-labelledby={`${coOp.id}-h`}>
      <div class="container coop-inner">
        <div class="coop-text">
          <p class="eyebrow">{coOp.where}</p>
          <h2 id={`${coOp.id}-h`}>{coOp.name}</h2>
          <p class="coop-lead">{coOp.lead}</p>
          <p class="coop-about">{coOp.about}</p>
          <div class="hero-buttons">
            <a class="btn btn-ink" href={coOp.website_url}>{coOp.website_label}</a>
            <a class="btn btn-outline" href={coOp.directions}>Get directions</a>
          </div>
        </div>
        <div class="coop-cards">
          <div class="coop-card">
            <h3>Hours</h3>
            {coOp.hours.map((row) => (
              <div class="coop-hours"><span>{row.days}</span><span class="coop-time">{row.time}</span></div>
            ))}
          </div>
          <div class="coop-card coop-contact">
            <h3>Contact</h3>
            <span>{coOp.address}</span>
            {coOp.contacts.map((contact) => <a class="link-strong" href={contact.href}>{contact.label}</a>)}
          </div>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .coops-hero { padding-bottom: 88px; }
  .page-hero .coops-title {
    font-size: clamp(64px, 9vw, 132px);
    line-height: 0.88;
  }
  .no-break { white-space: nowrap; }
  .coops-lead {
    font-family: var(--slab);
    font-weight: 600;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.3;
    margin: 32px 0 0;
    max-width: 900px;
  }
  .coops-intro { font-size: 19px; margin: 18px 0 0; max-width: 720px; }

  .map-row {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    margin-top: 56px;
    align-items: flex-start;
  }
  .map-figure { flex: 2 1 560px; min-width: 0; margin: 0; }
  /* The map is a picture. The labels sit on top as text so they stay sharp
     and readable on phones. Their spots match the pins in the picture;
     each is anchored on the side nearest its pin so it never covers it. */
  .map {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 1762 / 861;
    border: 3px solid #9A432C;
    border-radius: 24px;
    overflow: hidden;
    background: #ECE7DE;
  }
  .map img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .map-label {
    position: absolute;
    background: #2F6A9E;
    color: #FFFFFF;
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: max(11px, 1.92cqw);
    line-height: 1;
    padding: 0.3em 0.14em 0.32em;
    white-space: nowrap;
  }
  .label-bikerowave { right: 77.05%; top: 75.84%; }
  .label-kitchen { right: 28.92%; top: 6.54%; background: #98332A; }
  .label-oven { right: 4.68%; top: 11.52%; }
  figcaption { margin-top: 10px; font-size: 14px; color: var(--muted); }

  .coop {
    padding-top: 88px;
    padding-bottom: 88px;
    border-top: 3px solid var(--ink);
  }
  .coop-inner { display: flex; flex-wrap: wrap; gap: 48px 80px; }
  .coop-text { flex: 1.3 1 480px; min-width: 0; }
  .coop-text .eyebrow { margin-bottom: 10px; }
  .coop-text h2 {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 64px;
    line-height: 0.95;
    margin: 0 0 22px;
  }
  .coop-lead {
    font-family: var(--slab);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    margin: 0 0 18px;
    max-width: 620px;
  }
  .coop-about { margin: 0; max-width: 620px; }
  .coop-text .hero-buttons { margin-top: 28px; }

  .coop-cards {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .coop-card {
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 4px;
    padding: 22px 24px;
  }
  .coop-card h3 {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 24px;
    margin: 0 0 8px;
  }
  .coop-hours {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 0;
    border-bottom: 1px solid #C2B8A8;
  }
  .coop-time { font-weight: 600; text-align: right; }
  .coop-contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow-wrap: anywhere;
  }
  .coop-contact h3 { margin-bottom: 4px; }

  @media (max-width: 759px) {
    .coops-hero { padding-bottom: 64px; }
    .page-hero .coops-title { font-size: clamp(48px, 16vw, 110px); }
    .map-row { margin-top: 40px; }
    .map { border-width: 2px; border-radius: 16px; }
    .coop { padding-top: 64px; padding-bottom: 64px; }
    .coop-text h2 { font-size: 50px; }
  }
</style>
