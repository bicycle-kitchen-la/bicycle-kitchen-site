---
import PhotoSlot from '../components/PhotoSlot.astro';
import Steps from '../components/Steps.astro';
import Wheel from '../components/Wheel.astro';
import { links } from '../data/nav';
import { phoneHref, settings } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const ways = [
  { title: 'Shadow a volunteer', text: 'Learn from one of our established volunteers. Learn how to interact with clients, offer advice, and navigate the endless bins of tools and parts.' },
  { title: 'Sort parts', text: 'Keep our parts bins organized and stocked with ready to use parts. This is a great way to get familiar with what we have to offer our clients.' },
  { title: 'Repair donations', text: 'Use your repair knowledge to get donated bikes in ride ready condition.' },
  { title: 'Design community materials', text: 'Use your design skills to create flyers, event invites, and signage around the shop.' },
  { title: 'Help however you can', text: 'Share your desires, interests, and skills with established volunteers. They’ll help you find a way to get involved. Folks are always finding ways to help us that we haven’t thought of yet.' },
];

const startSteps = [
  {
    title: 'Stop by during open hours',
    text: 'Find time in your day to come during any of our open hours.',
    link: { label: 'See this week’s hours', href: links.hours.href },
  },
  { title: 'Connect with a volunteer', text: 'Introduce yourself to a volunteer on shift and let them know you’re interested in becoming a volunteer. Share with them how knowledgeable you are with repairs and they’ll help you find a way to support us.' },
  { title: 'Keep coming back', text: 'We recommend picking one shift and sticking with it. You’ll build relationships with those volunteers and they’ll witness the ways you need support and have grown.' },
];
---

<BaseLayout
  title="Volunteer · Bicycle Kitchen"
  description="Bicycle Kitchen runs entirely on volunteers. No experience needed. If you can show up, we can teach you the rest."
  breadcrumbs={[{ label: 'Get Involved' }]}
  breadcrumbCurrent="Volunteer"
>
  <section class="page-hero" aria-labelledby="vol-title">
    <div class="container split">
      <div class="page-hero-text">
        <h1 id="vol-title" class="page-title">Volunteer<Wheel /></h1>
        <p class="lead">Become a part of our volunteer community! Help us get folks on bikes and keep them riding.</p>
        <p class="intro">No experience? No problem. We support each other in our shared learning and have knowledgeable volunteers who can show you the ropes.</p>
        <div class="hero-buttons">
          <a class="btn btn-ink" href="#start">How to get started</a>
          <a class="btn btn-outline" href={links.hours.href}>See shop hours</a>
        </div>
      </div>
      <PhotoSlot
        name="volunteer_hero"
        placeholder="Photo: volunteers in the yard"
        class="page-hero-photo volunteer-photo"
        sizes="(max-width: 1000px) 100vw, 460px"
        eager
      />
    </div>
  </section>

  <section class="section section-dark section-band on-dark" aria-label="Why volunteers matter">
    <div class="container split matter">
      <p class="matter-title">We are a reflection of our volunteers</p>
      <p class="matter-text">Want us to be open more often? Have ideas for our space? Be a part of the conversations that shape Bike Kitchen. There can never be too many Cooks in our kitchen ;)</p>
    </div>
  </section>

  <section id="ways" class="section section-alt" aria-labelledby="ways-title">
    <div class="container">
      <div class="heading-row">
        <h2 id="ways-title" class="h2">Ways to get involved</h2>
        <p>Look through some of the options below and see what calls out to you.</p>
      </div>
      <div class="rows ways">
        {ways.map((way) => (
          <div class="row">
            <h3>{way.title}</h3>
            <p>{way.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="start" class="section" aria-labelledby="start-title">
    <div class="container">
      <h2 id="start-title" class="h2 start-title">How to get started</h2>
      <Steps steps={startSteps} large />
      <div class="callout start-callout">
        <p><strong>Thursday is FTWNB night.</strong> Femme, trans, women and non-binary folks are especially welcome to come learn how to volunteer on Thursday evenings.</p>
      </div>
    </div>
  </section>

  <section class="section section-red section-band on-dark" aria-labelledby="q-title">
    <div class="container split questions">
      <div class="band-text">
        <h2 id="q-title" class="band-title">Questions before you come by?</h2>
        <p>Give us a call or send an email, and a volunteer will get back to you.</p>
      </div>
      <div class="action-stack">
        <a class="btn btn-white" href={phoneHref}>Call {settings.phone} During Open Hours</a>
        <a class="btn btn-ink" href={`mailto:${settings.email}`}>Email {settings.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split :global(.volunteer-photo) {
    flex-basis: 360px;
    max-width: 460px;
    height: 560px;
    --photo-position: 50% 45%;
  }

  .matter, .questions { gap: 32px 80px; }
  .matter-title {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 46px;
    line-height: 1.05;
    color: #FFFFFF;
    margin: 0;
    flex: 1.2 1 440px;
    min-width: 0;
  }
  .matter-text { font-size: 19px; margin: 0; flex: 1 1 380px; min-width: 0; max-width: 560px; }

  .ways .row { padding: 26px 4px; }
  .ways .row h3 { font-size: 30px; line-height: 1.1; flex-basis: 340px; }

  .start-title { margin-bottom: 40px; }
  .start-callout { margin-top: 56px; max-width: 820px; }

  @media (max-width: 759px) {
    .split :global(.volunteer-photo) { max-width: none; height: 380px; }
    .matter-title { font-size: 38px; }
    .ways .row h3 { font-size: 26px; }
  }
</style>
