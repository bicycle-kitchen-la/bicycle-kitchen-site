---
import Wheel from '../components/Wheel.astro';
import { links, showCoOps } from '../data/nav';
import { hours, phoneHref, settings } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hours · Bicycle Kitchen"
  description="Open shop hours at Bicycle Kitchen, 4429 Fountain Ave, Los Angeles. Calling before visiting is advised, since volunteer shortages occasionally result in last minute closures."
  breadcrumbCurrent="Hours"
>
  <section class="hours-section" aria-labelledby="hours-h">
    <div class="container">
      <h1 id="hours-h" class="page-title hours-title">Hours<Wheel /></h1>
      <div class="hours-layout">
        <div class="hours-main">
        <dl class="hours-list">
          {hours.days.map((row) => (
            <div class="hours-row">
              <dt>{row.day}</dt>
              <dd class="hours-time">{row.time}</dd>
              {row.note && <dd class="hours-note">{row.note}</dd>}
            </div>
          ))}
        </dl>
        <div class="call-card on-dark">
          <p class="call-title">Calling before visiting is advised.</p>
          <p class="call-text">Volunteer shortages occasionally result in last minute closures.</p>
          <a href={phoneHref}>
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
            {settings.phone}
          </a>
        </div>
        </div>

        <div class="hours-side">
          <p class="hours-intro">No appointment necessary! Show up, sign in, and get help from one of our volunteers.</p>
          <div>
            <p class="hours-address">{settings.address_line_1}<br />{settings.address_line_2}</p>
            <a class="link-strong" href={settings.directions_url}>Get directions</a>
          </div>
          {showCoOps && (
            <div class="closed-card section-alt">
              <p><strong>Closed tonight?</strong> Other volunteer-run co-ops around LA may be open.</p>
              <a class="link-strong" href={links.coOps.href}>See other LA co-ops</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hours-section { padding: 24px var(--gutter) 96px; overflow: hidden; }
  .hours-title { margin-bottom: 48px; }
  .hours-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 80px;
    align-items: flex-start;
  }

  .hours-main { flex: 1.4 1 480px; min-width: 0; }
  .hours-list {
    margin: 0;
    border-top: 3px solid var(--ink);
  }
  .hours-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--rule);
  }
  .hours-row dt {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 30px;
  }
  .hours-row dd { margin: 0; text-align: right; }
  .hours-time { font-weight: 600; font-size: 21px; }
  /* The note gets its own line so a long one never pushes the time out of line. */
  .hours-note {
    flex-basis: 100%;
    font-size: 16px;
    color: var(--ink);
    font-weight: 700;
  }

  .hours-side {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hours-intro { margin: 0; font-size: 19px; }

  /* A deeper red than the alert banner, so it reads as related but stands on its own. */
  .call-card {
    margin-top: 32px;
    background: var(--red-on-stone);
    color: #FFFFFF;
    padding: 26px 28px;
    border-radius: 4px;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .call-title {
    margin: 0 0 6px;
    font-family: var(--slab);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.15;
  }
  .call-text { margin: 0 0 12px; font-size: 19px; font-weight: 600; }
  .call-card a, .call-card a:hover {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }

  .hours-address { margin: 0 0 8px; font-weight: 600; font-size: 19px; }

  .closed-card {
    background: var(--stone-light);
    border-left: 6px solid var(--red);
    padding: 20px 24px;
  }
  .closed-card p { margin: 0 0 8px; }

  @media (max-width: 759px) {
    .hours-section { padding-bottom: 64px; }
    .hours-title { margin-bottom: 32px; }
    .hours-main, .hours-side { flex-basis: 100%; }
    .call-card { margin-top: 24px; padding: 22px 20px; box-shadow: 4px 4px 0 var(--ink); }
    .call-title { font-size: 26px; }
    .hours-row { padding: 14px 4px; }
    .hours-row dt { font-size: 26px; }
  }
</style>
