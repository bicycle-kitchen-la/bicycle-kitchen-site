---
import PhotoSlot from '../components/PhotoSlot.astro';
import Wheel from '../components/Wheel.astro';
import { links, showCoOps } from '../data/nav';
import { settings } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bicycle Kitchen / La Bici-Cocina"
  description="Bicycle Kitchen is a 501(c)(3) nonprofit bicycle repair collective in Los Angeles, providing space, tools, and guidance to anyone wanting to tackle their own repairs."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <h1 id="hero-title" class="sr-only">Fun. Safe. Accessible. Learn to fix your own bike at Bicycle Kitchen.</h1>

      <div class="hero-row hero-row-1">
        <div class="hero-word hero-word-fun" aria-hidden="true">Fun<Wheel order={1} /></div>
        <PhotoSlot
          name="home_hero_rider"
          placeholder="Photo: someone grinning on a bike they just fixed"
          class="hero-photo-rider"
          tone="dark"
          sizes="(max-width: 500px) 100vw, 400px"
          eager
        />
      </div>

      <div class="hero-row-2">
        <div class="hero-row-2-words">
          <div class="hero-row hero-safe">
            <PhotoSlot
              name="home_hero_brakes"
              placeholder="Photo: a volunteer showing someone how to adjust brakes"
              class="hero-photo-brakes"
              sizes="240px"
              eager
            />
            <div class="hero-word" aria-hidden="true">Safe<Wheel order={2} desktopArt="helmet" /></div>
          </div>
          <div class="hero-word hero-word-accessible" aria-hidden="true">Accessible<Wheel order={3} desktopArt="tandem" /></div>
        </div>
        <PhotoSlot
          name="home_hero_wheel"
          placeholder="Photo: wheel close-up"
          class="hero-photo-wheel"
          tone="mid"
          sizes="170px"
        />
      </div>

      <div class="hero-intro">
        <p>Bicycle Kitchen is a 501(c)(3) nonprofit bicycle repair collective. We are entirely run by a supportive community of volunteers who are committed to providing space, tools, and guidance to anyone wanting to tackle their own repairs. Our hope is that you will come down and work on your own bike or start a project bike through us!</p>
        <div class="hero-actions">
          <a class="btn btn-ink" href={links.hours.href}>Open Hours</a>
          <a class="btn btn-red" href={links.donate.href}>Support us</a>
          <a class="btn btn-ink" href={links.projectBikes.href}>Project bikes</a>
        </div>
      </div>
    </div>
  </section>

  <section id="programs" class="section section-alt" aria-labelledby="programs-title">
    <div class="container">
      <h2 id="programs-title" class="h2 programs-title">What we do</h2>
      <div class="programs">
        <article class="program">
          <PhotoSlot
            name="home_open_shop"
            placeholder="Photo: someone truing a wheel at a stand"
            class="program-photo"
            sizes="(max-width: 1100px) 100vw, 380px"
          />
          <h3>Open shop</h3>
          <p>Bicycle Kitchen exists to teach people how to repair and build bicycles. Visit during our open hours to ask questions, learn new ways of doing things, and hopefully complete the cycle by teaching others what you know.</p>
          <div class="program-links">
            <a class="link-strong" href={links.learn.href}>Our open shop model</a>
            <a class="link-strong" href={links.hours.href}>See when we’re open</a>
          </div>
        </article>
        <article class="program">
          <PhotoSlot
            name="home_project_bikes"
            placeholder="Photo: donated bikes lined up and waiting for new riders"
            class="program-photo"
            sizes="(max-width: 1100px) 100vw, 380px"
          />
          <h3>Project bikes</h3>
          <p>Pick one of our donated bikes, agree on a price, and build it up yourself with any used part in the shop. We work with any budget.</p>
          <div class="program-links">
            <a class="link-strong" href={links.projectBikes.href}>How project bikes work</a>
          </div>
        </article>
        <article class="program">
          <PhotoSlot
            name="home_volunteer"
            placeholder="Photo: volunteers in the yard"
            class="program-photo program-photo-volunteer"
            sizes="(max-width: 1100px) 100vw, 380px"
          />
          <h3>Volunteer</h3>
          <p>No experience needed. Shadow a volunteer, sort parts, repair donations, design flyers, or help however you can!</p>
          <div class="program-links">
            <a class="link-strong" href={links.volunteer.href}>How to get started</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="mission" class="section" aria-labelledby="mission-title">
    <div class="container mission">
      <div class="mission-text">
        <h2 id="mission-title" class="h2">Our mission</h2>
        <p>To promote the bicycle as a fun, safe, and accessible form of transportation, to foster healthy urban communities, and to provide a welcoming space to learn about building, maintaining, and riding bicycles.</p>
      </div>
      <nav class="mission-links" aria-label="About Bicycle Kitchen">
        <a href={links.who.href}>{links.who.label}</a>
        {showCoOps && <a href={links.coOps.href}>{links.coOps.label}</a>}
        <a href={links.supporters.href}>{links.supporters.label}</a>
      </nav>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="photos-title">
    <div class="container">
      <div class="floor-heading">
        <h2 id="photos-title" class="h2">From the shop floor</h2>
        <a href={settings.instagram_url}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5h.01"></path></svg>
          Follow {settings.instagram_handle}
        </a>
      </div>
      <div class="floor-photos">
        <PhotoSlot
          name="home_floor_ftwnb"
          placeholder="Photo: Thursday FTWNB night"
          class="floor-photo floor-photo-wide"
          sizes="(max-width: 800px) 100vw, 600px"
        />
        <PhotoSlot
          name="home_floor_parts"
          placeholder="Photo: the parts wall"
          class="floor-photo"
          tone="mid"
          sizes="(max-width: 800px) 100vw, 300px"
        />
        <PhotoSlot
          name="home_floor_rebuilt"
          placeholder="Photo: a rebuilt bike leaving the shop"
          class="floor-photo"
          sizes="(max-width: 800px) 100vw, 300px"
        />
      </div>
    </div>
  </section>

  <section id="donate" class="section section-red on-dark" aria-labelledby="donate-title">
    <div class="container donate">
      <div class="donate-text">
        <h2 id="donate-title" class="h2">Keep Bike Kitchen running</h2>
        <p class="donate-lead">Being 100% volunteer run guarantees your contributions end up serving others. With your generosity we can continue to connect bikes and parts to people who need them.</p>
        <p class="donate-note">Have a bike or parts to donate? Drop them off during open hours. Tax receipts available.</p>
      </div>
      <div class="action-stack donate-actions">
        <a class="btn btn-blue" href={settings.zeffy_url}>Donate with Zeffy</a>
        <a class="btn btn-white" href={settings.venmo_url}>Donate with Venmo</a>
        <a class="btn btn-white" href={settings.paypal_url}>Donate with PayPal</a>
        <a class="link-strong donate-more" href={links.donate.href}>See how we use donations</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { padding: 40px var(--gutter) 64px; overflow: hidden; }
  .hero-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 64px;
  }
  .hero-row-1 { align-items: flex-end; }
  .hero-word {
    font-family: var(--slab);
    font-weight: 700;
    font-size: clamp(88px, 14vw, 200px);
    line-height: 0.82;
    letter-spacing: -0.02em;
  }
  .hero-word-fun { margin-left: clamp(0px, 7vw, 104px); }
  .hero-row-2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 12px;
  }
  .hero-row-2-words { flex: 0 1 auto; min-width: 0; }
  .hero-safe { align-items: center; }
  .hero-word-accessible {
    margin-top: 12px;
    font-size: clamp(60px, 13.9vw, 200px);
    line-height: 0.86;
    margin-left: clamp(0px, 2vw, 28px);
  }
  .hero :global(.hero-photo-rider) {
    flex: 0 1 400px;
    max-width: 100%;
    height: 240px;
    padding: 16px;
    transform: rotate(1.5deg);
  }
  .hero :global(.hero-photo-brakes) {
    flex: 0 1 240px;
    max-width: 100%;
    height: 280px;
    padding: 16px;
  }
  .hero :global(.hero-photo-wheel) {
    flex: 0 0 170px;
    width: 170px;
    height: 170px;
    padding: 24px;
    border-radius: 50%;
    border: 6px solid var(--ink);
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .hero :global(.hero-photo-wheel.has-photo) { padding: 0; }
  .hero-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 3px solid var(--ink);
  }
  .hero-intro p { font-size: 21px; margin: 0; max-width: 640px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  /* What we do */
  .programs-title { margin-bottom: 40px; }
  .programs { display: flex; flex-wrap: wrap; gap: 40px; }
  .program {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .program h3 {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
    margin: 6px 0 0;
  }
  .program p { margin: 0; }
  .program-links { display: flex; flex-wrap: wrap; gap: 6px 24px; }
  .program :global(.program-photo) { height: 260px; }
  .program :global(.program-photo-volunteer) { --photo-position: 50% 40%; }

  /* Our mission */
  .mission {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 80px;
    align-items: flex-start;
  }
  .mission-text { flex: 2 1 520px; min-width: 0; }
  .mission-text h2 { margin-bottom: 24px; }
  .mission-text p {
    font-family: var(--slab);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.3;
    margin: 0;
    max-width: 760px;
  }
  .mission-links {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-top: 3px solid var(--ink);
  }
  .mission-links a {
    padding: 16px 4px;
    border-bottom: 1px solid var(--rule);
    font-weight: 600;
    font-size: 19px;
    text-decoration: none;
  }

  /* From the shop floor */
  .floor-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    margin-bottom: 32px;
  }
  .floor-heading a {
    font-weight: 600;
    font-size: 19px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .floor-photos { display: flex; flex-wrap: wrap; gap: 16px; }
  .floor-photos :global(.floor-photo) { flex: 1 1 240px; height: 340px; }
  .floor-photos :global(.floor-photo-wide) { flex: 2 1 380px; }

  /* Keep Bike Kitchen running */
  .donate {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 80px;
    align-items: center;
  }
  .donate-text { flex: 1.4 1 460px; min-width: 0; }
  .donate-text h2 { margin-bottom: 20px; }
  .donate-lead { margin: 0; font-size: 19px; max-width: 560px; }
  .donate-note { margin: 16px 0 0; max-width: 560px; color: #F6DED7; }
  .donate-actions { flex-basis: 320px; }
  .donate-more, .donate-more:hover {
    color: #FFFFFF;
    justify-content: center;
    text-align: center;
    margin-top: 4px;
  }

  @media (max-width: 759px) {
    .hero { padding-top: 24px; padding-bottom: 48px; }
    /* Phones stack the hero in one column: grinning photo, Fun, Safe,
       Accessible, brakes photo, then the intro. */
    .hero .container { display: flex; flex-direction: column; }
    .hero-row, .hero-row-2, .hero-row-2-words { display: contents; }
    .hero :global(.hero-photo-rider),
    .hero :global(.hero-photo-brakes) { flex: none; width: 100%; height: 190px; }
    .hero :global(.hero-photo-rider) { order: 1; transform: none; margin-bottom: 16px; }
    .hero-word-fun { order: 2; }
    .hero-safe .hero-word { order: 3; margin-top: 12px; }
    .hero-word-accessible { order: 4; }
    .hero :global(.hero-photo-brakes) { order: 5; margin-top: 16px; }
    .hero :global(.hero-photo-wheel) { display: none; }
    .hero-intro { order: 6; }
    .hero-word, .hero-word-accessible { font-size: clamp(44px, 15vw, 100px); margin-left: 0; }
    .hero-intro p { font-size: 19px; }
    .mission-text p { font-size: 24px; }
    .donate-text, .mission-text { flex-basis: 100%; }
  }
</style>
