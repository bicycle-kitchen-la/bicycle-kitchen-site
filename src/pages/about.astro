---
import PhotoSlot from '../components/PhotoSlot.astro';
import Wheel from '../components/Wheel.astro';
import { links, showCoOps } from '../data/nav';
import BaseLayout from '../layouts/BaseLayout.astro';

// Years since Bicycle Kitchen started in 2002. Worked out each time the site is
// built, so it moves up on its own after the new year.
const yearsOpen = new Date().getFullYear() - 2002;

const values = [
  { title: 'Fun.', text: 'Dig through filing cabinets full of used parts, bins of forks, and cubbies with all sorts of bits until you find exactly what you need!' },
  { title: 'Safe.', text: 'Ride off on a bike that passes the ABCs of cycling. Work on your bike until you know it’s safe and rides how you want.' },
  { title: 'Accessible.', text: 'Our pricing is on a sliding scale! We offer work trade if you can’t afford a monetary donation. We have a suggested donation of $8/hr of shop time and price parts individually.' },
];

const story = [
  { when: '2002', title: 'It started in a kitchen', text: 'Bike Kitchen originated in a kitchen at Koreatown’s Eco-Village. What started as a small repair spot for bike messengers quickly grew into the community hub we are today.' },
  { when: '2005', title: 'Landing at the Bicycle District', text: 'Having outgrown the Eco-Village’s generous (but small) kitchen, we set up shop on Heliotrope Drive and Melrose by LACC.' },
  { when: '2012', title: 'Finding a permanent home', text: 'With the community’s support we secured our building on Fountain Ave and Virgil. True to our name, a former bakery is now our forever home.' },
  {
    when: 'Today',
    title: 'Just one of LA’s bicycle co-ops',
    text: 'Bike Kitchen is a bicycle repair collective, much like Bikerowave or the Bike Oven here in LA county, or The Bicycle Tree in Orange County. Together we work to keep as many cyclists rolling as we can.',
    link: showCoOps ? { label: 'Meet other LA co-ops', href: links.coOps.href } : undefined,
  },
];
---

<BaseLayout
  title="Our mission and who we are · Bicycle Kitchen"
  description="Bicycle Kitchen / La Bici-Cocina is a 501(c)(3) nonprofit run entirely by volunteers, promoting the bicycle as a fun, safe, and accessible form of transportation."
  breadcrumbs={[{ label: 'About' }]}
  breadcrumbCurrent="Our mission and who we are"
>
  <section class="page-hero" aria-labelledby="mission-h">
    <div class="container">
      <h1 id="mission-h" class="page-title">Our mission<Wheel /></h1>
      <p class="mission-statement">To promote the bicycle as a fun, safe, and accessible form of transportation, to foster healthy urban communities, and to provide a welcoming space to learn about building, maintaining, and riding bicycles.</p>
      <div class="values">
        {values.map((value) => (
          <div class="value">
            <h2>{value.title}</h2>
            <p>{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark section-band on-dark" aria-label="How we work">
    <div class="container split teach">
      <p class="teach-title">DIT to DIY.</p>
      <div class="teach-text">
        <p>Repair your bike with our help or on your own. Jump into getting your hands dirty and learn from the experience!</p>
        <p>If we don’t know how to get your bike ride ready, we’ll do our best to point you to someone who can.</p>
      </div>
    </div>
  </section>

  <section id="who" class="section section-alt" aria-labelledby="who-h">
    <div class="container split">
      <div class="who-text">
        <h2 id="who-h" class="h2">Who we are</h2>
        <p>Bicycle Kitchen / La Bici-Cocina is a 501(c)(3) nonprofit run entirely by volunteers.</p>
        <p>Volunteers have helped keep Bike Kitchen open to all for over {yearsOpen} years. With our community of volunteers we are able to teach repairs, connect bikes to those in need, and connect with folks as we try to get more people on two wheels.</p>
        <p>Everyone is welcome here.</p>
        <p class="who-link"><a class="link-strong" href={links.volunteer.href}>Become a volunteer</a></p>
      </div>
      <PhotoSlot
        name="about_cooks"
        placeholder="Photo: a group shot of the volunteers at the shop"
        class="who-photo"
        sizes="(max-width: 1040px) 100vw, 570px"
      />
    </div>
  </section>

  <section class="section" aria-labelledby="story-h">
    <div class="container">
      <h2 id="story-h" class="h2 story-title">Our story</h2>
      <ol class="story">
        {story.map((moment) => (
          <li>
            <span class="story-when">{moment.when}</span>
            <div class="story-text">
              <h3>{moment.title}</h3>
              <p>{moment.text}</p>
              {moment.link && <p class="story-link"><a class="link-strong" href={moment.link.href}>{moment.link.label}</a></p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-red section-band on-dark" aria-labelledby="visit-h">
    <div class="container split band">
      <div class="band-text">
        <h2 id="visit-h" class="band-title">Check us out!</h2>
        <p>Need to do a repair? Looking for advice? Want to see how a bike repair collective has reimagined an old bakery? Visit us during any of our open hours.</p>
      </div>
      <div class="action-stack">
        <a class="btn btn-white" href={links.hours.href}>See shop hours</a>
        <a class="btn btn-ink" href={links.donate.href}>Support the Kitchen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mission-statement {
    font-family: var(--slab);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.25;
    margin: 36px 0 0;
    max-width: 980px;
  }
  .values { display: flex; flex-wrap: wrap; gap: 40px; margin-top: 72px; }
  .value {
    flex: 1 1 300px;
    min-width: 0;
    border-top: 3px solid var(--ink);
    padding-top: 18px;
  }
  .value h2 {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    margin: 0 0 12px;
  }
  .value p { margin: 0; }

  .teach, .band { gap: 32px 80px; }
  .teach-title {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    color: #FFFFFF;
    margin: 0;
    flex: 1 1 360px;
  }
  .teach-text { font-size: 19px; flex: 1.4 1 440px; min-width: 0; max-width: 620px; }
  .teach-text p { margin: 0; }
  .teach-text p + p { margin-top: 16px; }

  .who-text { flex: 1 1 440px; min-width: 0; }
  .who-text h2 { margin-bottom: 24px; }
  .who-text p { margin: 0 0 16px; max-width: 560px; font-size: 19px; }
  .who-text .who-link { margin: 28px 0 0; }
  .split :global(.who-photo) {
    flex: 1 1 440px;
    min-width: 0;
    height: 420px;
    padding: 16px;
    transform: rotate(-1.5deg);
  }
  .split :global(.who-photo.has-photo) { padding: 0; }
  /* A tall video (a YouTube Short) keeps its phone-screen shape */
  .split :global(.who-photo.is-tall) {
    flex: 0 0 auto;
    width: min(100%, 340px);
    height: auto;
    aspect-ratio: 9 / 16;
    padding: 0;
    margin-inline: auto;
  }

  .story-title { margin-bottom: 32px; }
  .story {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--ink);
  }
  .story li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 48px;
    padding: 28px 4px;
    border-bottom: 1px solid var(--rule);
  }
  .story-when {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 56px;
    line-height: 0.9;
    color: var(--red);
    flex: 0 0 180px;
  }
  .story-text { flex: 1 1 420px; min-width: 0; max-width: 680px; }
  .story-text h3 {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
    margin: 0 0 8px;
  }
  .story-text p { margin: 0; }
  .story-text .story-link { margin-top: 12px; }

  @media (max-width: 759px) {
    .values { margin-top: 48px; }
    .teach-title { font-size: 46px; }
    .split :global(.who-photo) { height: 280px; transform: none; }
    .story-when { font-size: 46px; }
  }
</style>
