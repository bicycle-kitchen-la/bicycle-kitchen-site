---
import PhotoSlot from '../components/PhotoSlot.astro';
import Steps from '../components/Steps.astro';
import Wheel from '../components/Wheel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const howSteps = [
  {
    title: 'Pick a bike',
    text: 'Find a bike that’s the right size and matches the style of riding you want to do. Availability varies. You might need to visit us multiple times before finding a match.',
  },
  { title: 'Agree on a price', text: 'We work with any budget. Together, we come to a shared understanding of what your project bike will cost.' },
  { title: 'Make it yours', text: 'Work on your project and freely swap in any of our used parts that are available. Only new parts add on top of our agreed upon price.' },
  { title: 'Finish in 30 days', text: 'You have 30 days to finish your project. After that, the bike may go back into circulation for someone else. We always try to give you a courtesy contact before then.' },
];

const questions = [
  { question: 'Who can get a project bike?', answer: 'Anyone! Just share your desire to start a project with any of our volunteers.', note: 'Limit of one project bike per year.' },
  { question: 'What does the price include?', answer: 'The bike plus any used part available in our shop. Swap or change parts as much as you need for the price you agreed on.', note: 'New parts come at an added cost.' },
  { question: 'What if I can’t finish in 30 days?', answer: 'Let somebody know you want an extension! After 30 days, we’ll try contacting you to see if you need an extension, otherwise your project will become available for anyone else to work on.' },
  { question: 'Can I pay with work trade?', answer: 'Yes. Please let a volunteer know you want to do work trade when first setting up a project. Every hour of work trade, like cleaning or organizing, takes $15 off your bike’s price.' },
];
---

<BaseLayout
  title="Project bikes · Bicycle Kitchen"
  description="Build your next bike yourself from one of our many donations. Anyone can get connected with a donated bike and work on it with tools, used parts, and a volunteer to help."
  breadcrumbs={[{ label: 'Bike Repair' }]}
  breadcrumbCurrent="Project bikes"
>
  <section class="page-hero" aria-labelledby="pb-title">
    <div class="container split">
      <div class="page-hero-text">
        <h1 id="pb-title" class="page-title">Project bikes<Wheel /></h1>
        <p class="lead">Build your next bike yourself, from one of our many donations.</p>
        <p class="intro">Anyone can come in, get connected with a donated bike, and work on it as their own project, with tools, used parts, and a volunteer to help.</p>
        <div class="hero-buttons">
          <a class="btn btn-ink" href="#how">How it works</a>
          <a class="btn btn-outline" href="#work-trade">About Work Trade</a>
        </div>
      </div>
      <PhotoSlot
        name="project_hero"
        placeholder="Photo: donated bikes lined up and waiting for new riders"
        class="page-hero-photo"
        sizes="(max-width: 1000px) 100vw, 500px"
        eager
      />
    </div>
  </section>

  <section id="how" class="section section-alt" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="h2 how-title">How it works</h2>
      <Steps steps={howSteps} />
    </div>
  </section>

  <section id="work-trade" class="section section-dark on-dark" aria-labelledby="wt-title">
    <div class="container split">
      <div class="trade-text">
        <p class="eyebrow">We work with any budget</p>
        <h2 id="wt-title" class="h2 trade-title">Work Trade</h2>
        <p class="trade-lead">Support us in supporting you. Earn $15 off the cost of your project for every hour you help us with tasks like cleaning and organizing the shop.</p>
      </div>
      <div class="trade-card">
        <div class="trade-amount">$15 off</div>
        <div class="trade-unit">per hour of work trade</div>
        <p>For example, 4 hours of cleaning and organizing takes $60 off your project’s price.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title" class="h2 faq-title">Good to know</h2>
      <div class="rows">
        {questions.map((item) => (
          <div class="row">
            <h3>{item.question}</h3>
            <p>{item.answer}{item.note && <> <em>{item.note}</em></>}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .how-title { margin-bottom: 40px; }
  .faq-title { margin-bottom: 32px; }

  .trade-text { flex: 1.3 1 480px; min-width: 0; }
  .trade-title { font-size: 56px; margin-bottom: 22px; }
  .trade-lead { margin: 0; font-size: 19px; max-width: 600px; }
  .trade-card {
    flex: 1 1 340px;
    min-width: 0;
    background: var(--stone);
    color: var(--ink);
    border-radius: 4px;
    padding: 32px;
    transform: rotate(-1.5deg);
  }
  .trade-amount {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 96px;
    line-height: 0.9;
  }
  .trade-unit {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 28px;
    margin-top: 6px;
  }
  .trade-card p {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 2px dashed var(--rule);
  }

  @media (max-width: 759px) {
    .trade-title { font-size: 46px; }
    .trade-card { transform: none; padding: 24px; }
  }
</style>
