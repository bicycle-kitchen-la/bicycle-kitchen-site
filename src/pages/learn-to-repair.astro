---
import PhotoSlot from '../components/PhotoSlot.astro';
import Steps from '../components/Steps.astro';
import Wheel from '../components/Wheel.astro';
import { links } from '../data/nav';
import { settings } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const visitSteps = [
  { title: 'Sign in', text: 'Show up during our open hours, say hello, and sign in on our iPad.' },
  { title: 'Grab a stand', text: 'Describe your problem to one of our volunteers. You two will work together in diagnosing and identifying next steps in your repair.' },
  { title: 'Learn as you go', text: 'New tools and new repairs can be intimidating. We are here to support you as you learn how to successfully get your bike rolling.' },
  { title: 'Roll out with new skills', text: 'Ride away knowing your bike is safe and ready to ride. We’ll be here to repeat the cycle on your next repair :)' },
];

const repairs = [
  { title: 'Fix a flat', text: 'Learn how to remove a tire, find a hole in your tube, patch it, and get everything back on your wheel. Never be stranded by a flat again!' },
  { title: 'Adjust your brakes', text: 'Squishy brakes? Not stopping even though every cell in your body is screaming to stop? Get help adjusting your brakes so you feel safe on the road. We help you learn how to replace pads, adjust tension/sensitivity, and how to maintain good braking performance over time.' },
  { title: 'Tune your shifting', text: 'Adjust your derailleurs and cable tension until you are shifting predictably and smoothly again. It’s easier than you think!' },
  { title: 'Clean and lube your chain', text: 'Build a strong habit of keeping your chain clean and happy. It will prevent premature wear on parts and keep you riding for longer.' },
  { title: 'True a wheel', text: 'Learn about the tug-of-rope action holding your wheel together. Take care of that wobbly wheel once and for all.' },
  { title: 'Build a bike', text: 'Start from a donated frame and parts and put together a whole bike, piece by piece.' },
  { title: 'Almost any repair', text: 'Don’t see your repair here? Come try it anyway. We’ll help you figure it out and dig in. We don’t have every tool imaginable, but we have a lot, and we’ll do our best to get you rolling.' },
];
---

<BaseLayout
  title="Learn to repair · Bicycle Kitchen"
  description="Bicycle Kitchen is a DIY bike repair space in Los Angeles. Use our tools and knowledge as you tackle a repair, and ask away if you don’t know how to start."
  breadcrumbs={[{ label: 'Bike Repair' }]}
  breadcrumbCurrent="Learn to repair"
>
  <section class="page-hero" aria-labelledby="lr-title">
    <div class="container split">
      <div class="page-hero-text">
        <h1 id="lr-title" class="page-title">Learn to repair<Wheel /></h1>
        <p class="intro lr-intro">Being a DIY space, you will have access to our tools and knowledge as you tackle a repair. Don’t know how to even start a repair? Ask away and we’ll do our best to guide you through it.</p>
        <div class="hero-buttons">
          <a class="btn btn-ink" href="#learn">What you can learn</a>
          <a class="btn btn-outline" href={links.hours.href}>See shop hours</a>
        </div>
      </div>
      <PhotoSlot
        name="learn_hero"
        placeholder="Photo: a volunteer walking someone through a repair at the stand"
        class="page-hero-photo"
        sizes="(max-width: 1000px) 100vw, 500px"
        eager
      />
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="visit-title">
    <div class="container">
      <h2 id="visit-title" class="h2 visit-title">How a visit works</h2>
      <Steps steps={visitSteps} />
    </div>
  </section>

  <section id="learn" class="section" aria-labelledby="learn-title">
    <div class="container">
      <div class="heading-row">
        <h2 id="learn-title" class="h2">Common repair lessons</h2>
        <p>Don’t see a repair you’re trying to tackle? We can still help. This list isn’t exhaustive.</p>
      </div>
      <div class="repairs">
        {repairs.map((repair) => (
          <div class="repair">
            <h3>{repair.title}</h3>
            <p>{repair.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark workshops on-dark" aria-labelledby="ws-title">
    <div class="container split">
      <div class="workshops-text">
        <h2 id="ws-title" class="h2">Repair workshops</h2>
        <p>A few times a year, we host hands-on classes on repair and maintenance. We announce them on Instagram first.</p>
      </div>
      <div class="action-stack">
        <a class="btn btn-stone" href={settings.instagram_url}>Follow {settings.instagram_handle} for dates</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tips-title">
    <div class="container tips">
      <div class="tips-text">
        <h2 id="tips-title" class="h2">Before you come</h2>
        <div class="tips-list">
          <p><strong>Bring your bike,</strong> plus any parts you’ve already bought for it.</p>
          <p><strong>Wear clothes that can get greasy.</strong> Bike repair is messy work.</p>
          <p><strong>Give yourself time.</strong> Learning takes longer than having someone else do it, and that’s the point.</p>
        </div>
      </div>
      <div class="callout tips-callout">
        <p><strong>Thursday is FTWNB night.</strong> During Thursday open hours, the shop is open to femme, trans, women and non-binary folks.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lr-intro { margin-top: 28px; font-size: 21px; }
  .visit-title { margin-bottom: 40px; }

  .repairs {
    display: flex;
    flex-wrap: wrap;
    column-gap: 48px;
    border-top: 3px solid var(--ink);
  }
  .repair {
    flex: 1 1 460px;
    min-width: 0;
    padding: 20px 4px;
    border-bottom: 1px solid var(--rule);
  }
  .repair h3 {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.1;
    margin: 0 0 6px;
  }
  .repair p { margin: 0; }

  .workshops { padding-top: 88px; padding-bottom: 88px; }
  .workshops .split { gap: 32px 80px; }
  .workshops-text { flex: 1.3 1 480px; min-width: 0; }
  .workshops-text h2 { margin-bottom: 20px; }
  .workshops-text p { margin: 0; font-size: 19px; max-width: 600px; }

  .tips {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 80px;
    align-items: flex-start;
  }
  .tips-text { flex: 1.3 1 480px; min-width: 0; }
  .tips-text h2 { margin-bottom: 24px; }
  .tips-list { border-top: 3px solid var(--ink); }
  .tips-list p {
    margin: 0;
    padding: 18px 4px;
    border-bottom: 1px solid var(--rule);
  }
  .tips-callout { flex: 1 1 340px; min-width: 0; padding: 24px 26px; }

  @media (max-width: 759px) {
    .workshops { padding-top: 64px; padding-bottom: 64px; }
  }
</style>
